# Public hostname for the auth API and the current web pages. DNS must point
# at this server, and the TLS certificate must cover this name.
AUTH_DOMAIN=auth.example.com

# Public hostname reserved for the user center and admin panel. In phase 1 it
# redirects to AUTH_DOMAIN. It must be a different name and must also be
# covered by the same TLS certificate (or a wildcard certificate).
ACCOUNT_DOMAIN=account.example.com

# Database password used by PostgreSQL and the auth service.
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Shown on the account pages and in the Yggdrasil metadata.
SERVER_NAME=Example Auth

# Required for the first account when set. Remove or change it after creating
# the administrator account.
BOOTSTRAP_TOKEN=change-this-bootstrap-token

# invite: an invite code is required
# open:   anyone may register, protected by CAPTCHA_MODE
# closed: no new registrations (the first account can still bootstrap)
REGISTRATION_MODE=invite

# off or required. required also needs the SMTP settings below.
# Bring up the Stalwart profile and run scripts/provision-mail.sh before
# switching this to required.
EMAIL_VERIFICATION=off

# none, pow, or turnstile. Turnstile needs both keys.
CAPTCHA_MODE=none
POW_DIFFICULTY=16

# In-process anti-abuse limits. Nginx also applies edge limits.
REGISTER_LIMIT_PER_HOUR=3
REGISTER_LIMIT_PER_DAY=10
REGISTER_LIMIT_GLOBAL_PER_HOUR=100
LOGIN_LIMIT_PER_MINUTE=10
POW_CHALLENGE_LIMIT_PER_MINUTE=30
PROFILE_LOOKUP_LIMIT_PER_MINUTE=60
FORGOT_LIMIT_PER_MINUTE=5
VERIFY_LIMIT_PER_MINUTE=10
REFRESH_LIMIT_PER_MINUTE=60
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Web session and Yggdrasil access-token lifetimes in days.
SESSION_DAYS=30
TOKEN_DAYS=30

# Account API v1 token lifetimes.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# SMTP settings for EMAIL_VERIFICATION=required.
# These defaults match the optional Stalwart profile in compose.yaml.
# For an external SMTP provider, override SMTP_HOST/PORT/USERNAME/PASSWORD/TLS.
# When using Stalwart, keep SMTP_PASSWORD equal to MAIL_NO_REPLY_PASSWORD.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=change-this-to-a-strong-mail-password
SMTP_FROM=UMC Auth <no-reply@example.com>
SMTP_TLS=implicit

# Self-hosted mail (Stalwart, enabled with --profile mail).
# MAIL_DOMAIN is the email domain, for example example.com.
# MAIL_HOSTNAME is the mail server hostname, for example mail.example.com.
# The TLS certificate in certs/ must cover MAIL_HOSTNAME.
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
MAIL_ADMIN_PASSWORD=change-this-to-a-strong-mail-admin-password
MAIL_NO_REPLY_ADDRESS=no-reply@example.com
MAIL_NO_REPLY_PASSWORD=change-this-to-a-strong-mail-password

# Only used during first-run provisioning. scripts/provision-mail.sh sets it
# temporarily and recreates the mail container without it. Leave it unset.
# STALWART_RECOVERY_ADMIN=

# Go log level: debug, info, warn, error.
LOG_LEVEL=info

# Texture storage inside the auth-api container. The Compose file mounts the
# auth-uploads volume at /data, so this default is persistent.
# UPLOAD_DIR=/data/uploads
