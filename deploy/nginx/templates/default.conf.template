# Rendered by the nginx image entrypoint. Only AUTH_DOMAIN and ACCOUNT_DOMAIN
# are substituted; Nginx runtime variables stay intact.
#
# Certificates expected in ./certs:
#   fullchain.pem  (leaf certificate followed by intermediates)
#   privkey.pem    (private key)
# The certificate must cover AUTH_DOMAIN and ACCOUNT_DOMAIN.

server {
    listen 80;
    listen [::]:80;
    server_name ${AUTH_DOMAIN} ${ACCOUNT_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${AUTH_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location = /healthz {
        proxy_pass http://auth-api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }

    # Yggdrasil authenticate is a password login endpoint. Keep its edge limit
    # close to LOGIN_LIMIT_PER_MINUTE instead of the general API rate.
    location = /api/yggdrasil/authserver/authenticate {
        limit_req zone=auth_login burst=5 nodelay;
        proxy_pass http://auth-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # No trailing slash here: /api/yggdrasil and /api/yggdrasil/... must both
    # reach the service without an automatic redirect.
    location /api/yggdrasil {
        limit_req zone=auth_api burst=20 nodelay;
        proxy_pass http://auth-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # The account panel is the only browser UI. Any page request on the auth
    # host is redirected there; API, Yggdrasil, and textures stay on this host.
    location = /api/v1/auth/refresh {
        limit_req zone=auth_refresh burst=20 nodelay;
        proxy_pass http://auth-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location ~ ^/api/v1/auth/(login|register|password/|verify-email) {
        limit_req zone=auth_login burst=5 nodelay;
        proxy_pass http://auth-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /api/ {
        limit_req zone=auth_api burst=20 nodelay;
        proxy_pass http://auth-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /textures/ {
        proxy_pass http://auth-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }

    # The auth host is an API-only host. The root returns service metadata
    # JSON; every other non-API path returns a JSON 404 instead of HTML.
    location = / {
        limit_req zone=auth_api burst=20 nodelay;
        proxy_pass http://auth-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        default_type application/json;
        return 404 '{"error":{"code":"not_found","message":"This host only serves the UMC Auth API"}}';
    }
}

# account.example.com serves the Vue user center and admin panel. The SPA is
# static; /api/ is proxied to the same auth service so refresh cookies remain
# first-party to the account host.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${ACCOUNT_DOMAIN};

    root /usr/share/nginx/html/account;
    index index.html;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Refresh rotates the HttpOnly refresh cookie on every SPA page load, so
    # it needs a separate, more generous edge limit than password login.
    location = /api/v1/auth/refresh {
        limit_req zone=auth_refresh burst=20 nodelay;
        proxy_pass http://auth-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Login, registration, verification, and password reset share the tighter
    # edge limit. The application applies its own limits too.
    location ~ ^/api/v1/auth/(login|register|password/|verify-email) {
        limit_req zone=auth_login burst=5 nodelay;
        proxy_pass http://auth-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /api/ {
        limit_req zone=auth_api burst=20 nodelay;
        proxy_pass http://auth-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri $uri/ /index.html;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://${AUTH_DOMAIN}; script-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
    }
}
